    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "htmlhint": "^1.9.2",
    "markdownlint-cli2": "^0.23.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
